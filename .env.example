# Docker Compose settings. Local development needs no environment file.
PORT=4321
PUBLIC_SITE_URL=http://localhost:4321
CRYPTOPATRO_MARKET_ENABLED=true
# Use shared_proxy behind an ingress that hides client IPs.
CRYPTOPATRO_RATE_LIMIT_MODE=client_ip

# Optional: enable provider-backed AI. Leave both empty for local summaries.
CRYPTOPATRO_AI_MODEL=
OPENAI_API_KEY=
CRYPTOPATRO_AI_RUNS_PER_HOUR=120
CRYPTOPATRO_AI_RUNS_PER_DAY=1000
CRYPTOPATRO_AI_MAX_CONCURRENT=4
