# No provider credentials are needed for portfolio tracking or local explanations.
CRYPTOPATRO_DATABASE_PATH=data/cryptopatro.sqlite3
CRYPTOPATRO_CORS_ORIGINS=["http://localhost:4321","http://127.0.0.1:4321"]
CRYPTOPATRO_MARKET_ENABLED=true
# Optional. Install the matching Pydantic AI provider extra for non-OpenAI providers.
# CRYPTOPATRO_AI_MODEL=openai:YOUR_MODEL_ID
# OPENAI_API_KEY=your_server_only_key

# Set true only behind the isolated frontend proxy that overwrites X-Forwarded-For.
CRYPTOPATRO_TRUST_PROXY_HEADERS=false

# Use shared_proxy when ingress replaces every visitor's source with a shared address.
# These are service capacity controls, not unique visitor or human verification.
CRYPTOPATRO_RATE_LIMIT_MODE=client_ip
CRYPTOPATRO_SERVICE_SESSIONS_PER_MINUTE=120
CRYPTOPATRO_SERVICE_SESSIONS_PER_HOUR=2000
CRYPTOPATRO_SERVICE_SHARES_PER_MINUTE=120
CRYPTOPATRO_SERVICE_SHARES_PER_HOUR=1000
CRYPTOPATRO_SERVICE_EVENTS_PER_MINUTE=600
CRYPTOPATRO_SERVICE_CHAT_PER_MINUTE=240
# Durable budgets count attempted AI runs, including errors. Zero uses local explanations.
CRYPTOPATRO_AI_RUNS_PER_HOUR=120
CRYPTOPATRO_AI_RUNS_PER_DAY=1000
CRYPTOPATRO_AI_MAX_CONCURRENT=4
