---
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/manrope';
import '../styles/globals.css';
interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}
const {
  title = 'CryptoPatro | Your crypto, a little clearer.',
  description = 'A calmer home for your crypto. Track your holdings, understand your allocation, and share your perspective. Free and open source.',
  image = '/og.png',
  noindex = false,
} = Astro.props;
const canonical = new URL(
  Astro.url.pathname,
  process.env.PUBLIC_SITE_URL || Astro.site || Astro.url.origin,
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f7f2" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, canonical)} />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'CryptoPatro',
        applicationCategory: 'FinanceApplication',
        operatingSystem: 'Web',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
        author: { '@type': 'Person', name: 'Doruk Gezici', url: 'https://github.com/dorukgezici' },
      })}
    />
  </head>
  <body>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <slot />
    <script>
      // Aggregate only explicit funnel actions, without identities or portfolio data.
      document.addEventListener('click', (event) => {
        const link = event.target instanceof Element ? event.target.closest('a') : null;
        if (!link) return;
        const href = link.getAttribute('href') || '';
        const name =
          href === 'https://github.com/dorukgezici'
            ? 'maker_clicked'
            : href.startsWith('/?start=1')
              ? 'start_clicked'
              : null;
        if (!name) return;
        const referral = location.pathname.startsWith('/share/')
          ? location.pathname.split('/')[2]
          : new URLSearchParams(location.search).get('ref');
        void fetch('/api/events', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, ...(referral ? { referral } : {}) }),
          keepalive: true,
        }).catch(() => {});
      });
    </script>
  </body>
</html>
